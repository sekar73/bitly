{
  "info": {
    "name": "Bitly Lab \u2014 Gateway, JWT and URL CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders in order against the local or AWS Nginx gateway. Registration generates fresh test credentials and saves JWTs in the selected environment. Lifecycle requests delete their own links; test user accounts are retained. Redirect requests disable automatic redirect following to inspect 302 responses. Keep exported environments private: they may contain passwords and JWTs."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 Health and gateway",
      "item": [
        {
          "name": "Read service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/read",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Read backend\", () => pm.expect(pm.response.json().service).to.eql(\"read\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Write service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/write",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Write backend\", () => pm.expect(pm.response.json().service).to.eql(\"write\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read API schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/read/openapi.json",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Write API schema",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/write/openapi.json",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 \u00b7 User authentication",
      "item": [
        {
          "name": "Register a fresh test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now() + \"-\" + pm.variables.replaceIn(\"{{$randomUUID}}\");",
                  "pm.environment.set(\"email\", \"postman-\" + suffix + \"@example.com\");",
                  "pm.environment.set(\"password\", pm.variables.replaceIn(\"{{$randomUUID}}\") + \"-Lab9!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) { const s = pm.response.json(); pm.environment.set(\"access_token\", s.access_token); pm.environment.set(\"user_id\", s.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login \u2014 saves JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code < 300) { const s = pm.response.json(); pm.environment.set(\"access_token\", s.access_token); pm.environment.set(\"user_id\", s.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Current authenticated user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correct user\", () => pm.expect(pm.response.json().email).to.eql(pm.environment.get(\"email\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrect-password-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 \u00b7 Link lifecycle \u2014 run in order",
      "item": [
        {
          "name": "Create generated short link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.com/postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const link = pm.response.json(); pm.environment.set(\"code\", link.code); pm.environment.set(\"short_path\", link.short_path); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List my links",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/links?offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Created link is listed\", () => pm.expect(pm.response.json().some(l => l.code === pm.environment.get(\"code\"))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve original URL \u2014 public",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/links/{{code}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Original URL\", () => pm.expect(pm.response.json().original_url).to.eql(\"https://example.com/postman\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Redirect \u2014 inspect 302 Location",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/s/{{code}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Destination\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"https://example.com/postman\"));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Update my link",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links/{{code}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.org/updated\",\n  \"expires_at\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Redirect reflects update",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/s/{{code}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Updated destination\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"https://example.org/updated\"));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Delete my link",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/links/{{code}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deleted link returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/s/{{code}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
    {
      "name": "4 \u00b7 Alias and expiration",
      "item": [
        {
          "name": "Create custom alias with expiration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.com/alias\",\n  \"alias\": \"{{alias}}\",\n  \"expires_at\": \"{{expires_at}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"alias\", \"pm-\" + Date.now());",
                  "pm.environment.set(\"expires_at\", new Date(Date.now() + 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set(\"alias_code\", pm.response.json().code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate alias returns 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.com\",\n  \"alias\": \"{{alias}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete custom alias",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/links/{{alias_code}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Past expiration is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.com\",\n  \"expires_at\": \"2020-01-01T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 \u00b7 Authorization and validation",
      "item": [
        {
          "name": "Anonymous create is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Anonymous list is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/links",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid URL is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"javascript:alert(1)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid alias is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.com\",\n  \"alias\": \"bad space\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6 \u00b7 Cross-user ownership",
      "item": [
        {
          "name": "Register a second user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{other_email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"other_email\", \"other-\" + Date.now() + \"-\" + pm.variables.replaceIn(\"{{$randomUUID}}\") + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set(\"other_token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create link as first user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.com/owner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set(\"owner_code\", pm.response.json().code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Second user cannot edit first user link",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/links/{{owner_code}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_url\": \"https://example.org/stolen\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{other_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Second user cannot delete first user link",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/links/{{owner_code}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{other_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Second user cannot list first user link",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/links",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{other_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Owner isolation\", () => pm.expect(pm.response.json().some(l => l.code === pm.environment.get(\"owner_code\"))).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner deletes test link",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/links/{{owner_code}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
